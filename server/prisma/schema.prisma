generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DENTIST
  ASSISTANT
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ToothStatus {
  HEALTHY
  TREATED
  DECAYED
  MISSING
  CROWN
  IMPLANT
  BRIDGE
  FILLING
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(PATIENT)
  phone     String?
  avatar    String?
  active    Boolean  @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastEditedBy   String?
  lastEditedAt   DateTime?

  patient          Patient?
  dentistSchedules DentistSchedule[] @relation("DentistSchedules")
  dentistAppointments  Appointment[] @relation("DentistAppointments")
  dentistQueueEntries  QueueEntry[]  @relation("DentistQueueEntries")
  treatments       Treatment[]
  xrayUploads      XrayImage[]
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  passwordResetTokens PasswordResetToken[]
}

model Patient {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dob           DateTime
  gender        String?
  bloodType     String?
  address       String?
  allergies     String?
  medicalHistory String?
  emergencyContact String?
  insuranceInfo String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teeth         Tooth[]
  appointments  Appointment[]
  treatments    Treatment[]
  prescriptions Prescription[]
  xrayImages    XrayImage[]
  queueEntries  QueueEntry[]
  patientBadges PatientBadge[]
  loyaltyPoints LoyaltyPoints?
  perkUsages    PerkUsage[]
  payments      Payment[]
}

model Tooth {
  id         String     @id @default(cuid())
  patientId  String
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber Int
  status     ToothStatus @default(HEALTHY)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  treatments Treatment[]

  @@unique([patientId, toothNumber])
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId   String
  dentist     User              @relation("DentistAppointments", fields: [dentistId], references: [id], onDelete: Restrict)
  roomId      String?
  room        Room?             @relation(fields: [roomId], references: [id])
  date        DateTime
  time        String
  duration    Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  treatments Treatment[]
  payments   Payment[]
}

model Room {
  id        String     @id @default(cuid())
  number    Int        @unique
  name      String
  status    RoomStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  appointments Appointment[]
}

model Treatment {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothId       String?
  tooth         Tooth?   @relation(fields: [toothId], references: [id])
  dentistId     String
  dentist       User     @relation(fields: [dentistId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  procedure     String
  description   String?
  notes         String?
  cost          Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prescriptions Prescription[]
}

model Prescription {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentId String?
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  medication  String
  dosage      String
  frequency   String
  duration    String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model XrayImage {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  filePath   String
  fileType   String
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  analysis   Json?
  createdAt  DateTime @default(now())
}

model QueueEntry {
  id            String      @id @default(cuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId     String?
  dentist           User?       @relation("DentistQueueEntries", fields: [dentistId], references: [id], onDelete: SetNull)
  position      Int
  status        QueueStatus @default(WAITING)
  estimatedWait Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DentistSchedule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("DentistSchedules", fields: [userId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  @@unique([userId, dayOfWeek])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  category    String
  threshold   Int      @default(1)
  points      Int      @default(10)
  createdAt   DateTime @default(now())

  patientBadges PatientBadge[]
}

model PatientBadge {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([patientId, badgeId])
}

model LoyaltyPoints {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  tier      String   @default("Bronze")
  updatedAt DateTime @updatedAt

  transactions PointTransaction[]
}

model PointTransaction {
  id              String   @id @default(cuid())
  loyaltyPointsId String
  loyaltyPoints   LoyaltyPoints @relation(fields: [loyaltyPointsId], references: [id], onDelete: Cascade)
  amount          Int
  description     String
  type            String   @default("EARNED")
  createdAt       DateTime @default(now())
}

enum PerkStatus {
  REQUESTED
  APPLIED
  EXPIRED
}

model PerkUsage {
  id        String     @id @default(cuid())
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  perk      String
  status    PerkStatus @default(REQUESTED)
  claimCode String
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime   @default(now())

  @@index([patientId, perk])
}

enum PaymentMethod {
  CASH
  GCASH
  CARD
  HMO
  PHILHEALTH
}

model Payment {
  id            String        @id @default(cuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  amount        Float
  method        PaymentMethod @default(CASH)
  status        String        @default("PAID")
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([paidAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
